  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-get-mode",
    "allow-toggle-lock",
    "allow-toggle-overlay",
    "allow-set-passthrough"
  ]
